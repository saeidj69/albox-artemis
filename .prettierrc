{
  "plugins": [
    "@trivago/prettier-plugin-sort-imports",
    "prettier-plugin-tailwindcss"
  ],
  "semi": false,
  "tabWidth": 2,
  "useTabs": false,
  "printWidth": 80,
  "endOfLine": "lf",
  "singleQuote": true,
  "arrowParens": "always",
  "importOrder": [
    "^react",
    "^next",
    "<THIRD_PARTY_MODULES>",
    "^@/app/(.*)$",
    "^@/components/(.*)$",
    "^@/modules/(.*)$",
    "^@/assets/(.*)$",
    "^@/utils/(.*)$",
    "^@/api/(.*)$",
    "^@/providers/(.*)$",
    "^@/features/(.*)$",
    "^@/styles/(.*)$",
    "^@/lib/(.*)$",
    "^[./]"
  ],
  "importOrderSeparation": true,
  "tailwindFunctions": ["tv", "cn"]
}
